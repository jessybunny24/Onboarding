generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model IncidentReport {
  id           String   @id @default(uuid())
  name         String
  email        String
  location     String
  incidentType String
  message      String
  createdAt    DateTime @default(now())
}
